{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "move": {
      "type": "object",
      "required": [
        "source",
        "dest"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/side"
        },
        "dest": {
          "$ref": "#/definitions/side"
        }
      }
    },
    "azcopy": {
      "type": "object",
      "properties": {
        "trailingDot": {
          "type": "string",
          "enum": [
            "Enable",
            "Disable",
            "AllowToUnsafeDestination"
          ]
        },
        "progressIntervalSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds between azcopy progress lines in the pod log. 0 prints every update."
        },
        "concurrencyValue": {
          "type": [
            "string",
            "integer"
          ],
          "description": "HTTP connections azcopy uses. Empty lets azcopy size it from logical cores. Accepts 64 or \"64\"."
        },
        "concurrentFiles": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Files transferred at once. Empty lets azcopy decide. Accepts 8 or \"8\"."
        }
      }
    },
    "adhocDelete": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cleanupEnabled": {
          "type": "boolean"
        },
        "listConfigMap": {
          "type": "string"
        },
        "listKey": {
          "type": "string",
          "minLength": 1
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ttlSecondsAfterFinished": {
      "type": [
        "integer",
        "string"
      ],
      "description": "Seconds after a Job finishes before Kubernetes deletes it and its pod. Empty string leaves it unset."
    }
  },
  "definitions": {
    "side": {
      "type": "object",
      "required": [
        "type",
        "container"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "blob",
            "file"
          ]
        },
        "storageAccount": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "Empty, or a scheme+host only, e.g. https://acct.privatelink.blob.core.windows.net. No path component.",
          "pattern": "^(https?://[^/]+)?$"
        },
        "container": {
          "type": "string"
        },
        "prefix": {
          "type": "string",
          "pattern": "^$|^[^/].*[^/]$|^[^/]$"
        }
      }
    }
  }
}
